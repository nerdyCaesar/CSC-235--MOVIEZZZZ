digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Movie catalog: many-to-many relationships\nPK = primary key; FK = foreign key; UQ = unique; ? = optional\nComposite PKs and constraints are listed in the guide and SQL"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=10,color="#718096",arrowsize=0.7];
age_ratings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>age_ratings</B></FONT></TD></TR><TR><TD ALIGN="LEFT">rating_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">rating_name</TD><TD ALIGN="LEFT">VARCHAR(20) UQ</TD></TR></TABLE>>];
movies [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>movies</B></FONT></TD></TR><TR><TD ALIGN="LEFT">movie_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">movie_title</TD><TD ALIGN="LEFT">VARCHAR(255) </TD></TR><TR><TD ALIGN="LEFT">synopsis</TD><TD ALIGN="LEFT">TEXT ?</TD></TR><TR><TD ALIGN="LEFT">release_date</TD><TD ALIGN="LEFT">DATE ?</TD></TR><TR><TD ALIGN="LEFT">runtime_minutes</TD><TD ALIGN="LEFT">SMALLINT ?</TD></TR><TR><TD ALIGN="LEFT">rating_id</TD><TD ALIGN="LEFT">INT FK,?</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP </TD></TR></TABLE>>];
genres [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>genres</B></FONT></TD></TR><TR><TD ALIGN="LEFT">genre_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">genre_name</TD><TD ALIGN="LEFT">VARCHAR(50) UQ</TD></TR></TABLE>>];
movie_genres [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>movie_genres</B></FONT></TD></TR><TR><TD ALIGN="LEFT">movie_id</TD><TD ALIGN="LEFT">INT PK,FK</TD></TR><TR><TD ALIGN="LEFT">genre_id</TD><TD ALIGN="LEFT">INT PK,FK</TD></TR></TABLE>>];
actors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>actors</B></FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">actor_name</TD><TD ALIGN="LEFT">VARCHAR(200) </TD></TR></TABLE>>];
movie_actors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>movie_actors</B></FONT></TD></TR><TR><TD ALIGN="LEFT">movie_id</TD><TD ALIGN="LEFT">INT PK,FK</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">INT PK,FK</TD></TR><TR><TD ALIGN="LEFT">billing_order</TD><TD ALIGN="LEFT">SMALLINT ?</TD></TR></TABLE>>];
directors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>directors</B></FONT></TD></TR><TR><TD ALIGN="LEFT">director_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">director_name</TD><TD ALIGN="LEFT">VARCHAR(200) </TD></TR></TABLE>>];
movie_directors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>movie_directors</B></FONT></TD></TR><TR><TD ALIGN="LEFT">movie_id</TD><TD ALIGN="LEFT">INT PK,FK</TD></TR><TR><TD ALIGN="LEFT">director_id</TD><TD ALIGN="LEFT">INT PK,FK</TD></TR></TABLE>>];
age_ratings -> movies [dir=none,taillabel="0..1",headlabel="0..many",labeldistance=2.5];
movies -> movie_genres [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
genres -> movie_genres [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
movies -> movie_actors [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
actors -> movie_actors [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
movies -> movie_directors [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
directors -> movie_directors [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
}