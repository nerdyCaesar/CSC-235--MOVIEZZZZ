digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Accounts and authentication\nPK = primary key; FK = foreign key; UQ = unique; ? = optional\nComposite PKs and constraints are listed in the guide and SQL"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=10,color="#718096",arrowsize=0.7];
roles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">role_type</TD><TD ALIGN="LEFT">VARCHAR(20) UQ</TD></TR></TABLE>>];
contacts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>contacts</B></FONT></TD></TR><TR><TD ALIGN="LEFT">contact_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(100) </TD></TR><TR><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(100) </TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(254) UQ</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(30) ?</TD></TR><TR><TD ALIGN="LEFT">street_1</TD><TD ALIGN="LEFT">VARCHAR(255) ?</TD></TR><TR><TD ALIGN="LEFT">street_2</TD><TD ALIGN="LEFT">VARCHAR(255) ?</TD></TR><TR><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT">VARCHAR(100) ?</TD></TR><TR><TD ALIGN="LEFT">state_code</TD><TD ALIGN="LEFT">VARCHAR(100) ?</TD></TR><TR><TD ALIGN="LEFT">post_code</TD><TD ALIGN="LEFT">VARCHAR(20) ?</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP </TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">contact_id</TD><TD ALIGN="LEFT">INT FK,UQ</TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">INT FK</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP </TD></TR></TABLE>>];
credentials [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>credentials</B></FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT PK,FK</TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">VARCHAR(50) UQ</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255) </TD></TR></TABLE>>];
password_reset_tokens [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#12374a"><FONT COLOR="white"><B>password_reset_tokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT">reset_id</TD><TD ALIGN="LEFT">INT PK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INT FK</TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">CHAR(64) UQ</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">DATETIME </TD></TR><TR><TD ALIGN="LEFT">used_at</TD><TD ALIGN="LEFT">DATETIME ?</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP </TD></TR></TABLE>>];
contacts -> users [dir=none,taillabel="1",headlabel="0..1",labeldistance=2.5];
roles -> users [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
users -> credentials [dir=none,taillabel="1",headlabel="0..1",labeldistance=2.5];
users -> password_reset_tokens [dir=none,taillabel="1",headlabel="0..many",labeldistance=2.5];
}